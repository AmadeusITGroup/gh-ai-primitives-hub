# Local Development Environment Configuration
# Copy this file to .env.local and customize for your local setup
# .env.local is git-ignored and won't be committed

# Override the repository URL to use your own fork
# Default: https://github.com/AmadeusITGroup/ai-primitives-hub.git
# Example: AI_PRIMITIVES_HUB_REPO="https://github.com/your-username/ai-primitives-hub.git"
AI_PRIMITIVES_HUB_REPO="https://github.com/AmadeusITGroup/ai-primitives-hub.git"

# Override the branch to use for development
# Default: (empty - uses latest tag)
# Example: AI_PRIMITIVES_HUB_REF="feature/my-feature"
# AI_PRIMITIVES_HUB_REF=""
